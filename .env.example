# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
#
# A long random string used to sign sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database. Leave as-is for SQLite (default), or point to another DB.
# DATABASE_URL=sqlite:///emjude.db

# ── Email (contact form) ──────────────────────────────
# For Gmail, MAIL_PASSWORD must be a 16-char App Password, NOT your normal password.
# Create one at: https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
CONTACT_RECEIVER=where-enquiries-should-be-sent@gmail.com
